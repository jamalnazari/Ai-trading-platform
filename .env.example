# ── Trader Insight backend settings ─────────────────────────────
# The single default administrator account (no registration in MVP).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me-in-production

# Public website name shown on the dashboard Settings page.
NEXT_PUBLIC_WEBSITE_NAME=Trader Insight
